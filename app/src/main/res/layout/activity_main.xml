<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Audio Section ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_audio"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_pick_audio" />

        <TextView
            android:id="@+id/tvAudioPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/none_selected"
            android:textAppearance="?attr/textAppearanceCaption"
            android:ellipsize="middle"
            android:singleLine="true" />

        <!-- ── Volume Normalisation Section ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_normalize"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:layout_marginTop="16dp" />

        <RadioGroup
            android:id="@+id/rgNormalize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbNormalizeNone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/normalize_none"
                android:checked="true" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbNormalizePeak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/normalize_peak" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbNormalizeRms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/normalize_rms" />

        </RadioGroup>

        <!-- ── Balance Section ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_balance"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L" />

            <SeekBar
                android:id="@+id/seekBalance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:max="200"
                android:progress="100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBalanceValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Center (0)"
            android:textAppearance="?attr/textAppearanceCaption" />

        <!-- ── Image Section ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_image"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:layout_marginTop="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_pick_image" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDefaultImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="@string/btn_use_default_image" />

        <TextView
            android:id="@+id/tvImagePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/default_black_image"
            android:textAppearance="?attr/textAppearanceCaption"
            android:ellipsize="middle"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerInside"
            android:background="#111111"
            android:contentDescription="Image preview" />

        <!-- ── Action Button ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_create_video" />

        <!-- ── Status ── -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/status_idle"
            android:textAppearance="?attr/textAppearanceBody1" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exports run in a foreground service so they continue when the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="Clip Merger"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name="com.example.clipmerger.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.clipmerger.TrimActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <service
            android:name="com.example.clipmerger.ExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
